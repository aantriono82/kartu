{
  "name": "kartu-ujian",
  "version": "1.0.6",
  "description": "Aplikasi pembuat kartu peserta ujian sekolah",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node scripts/run-tests.cjs",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --x64 --publish never"
  },
  "author": "Kartu Ujian",
  "license": "UNLICENSED",
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "vite": "^8.3.8"
  },
  "productName": "Kartu Ujian",
  "build": {
    "appId": "id.sch.kartuujian",
    "productName": "Kartu Ujian",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/exceljs/dist/**",
      "!node_modules/sql.js/dist/**",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "!**/*.map",
      "!**/*.{md,markdown}",
      "!**/*.d.ts"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "id",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Kartu Ujian",
      "artifactName": "KartuUjian-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "Kartu Ujian",
      "artifactName": "KartuUjian-${version}.${ext}"
    }
  }
}
